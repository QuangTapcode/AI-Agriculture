# Backend environment variables example

# Local assistant + document retrieval (ollama pull each model first)
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL_NAME=qwen3:4b-instruct
AI_TIMEOUT_SECONDS=120
AI_CONTEXT_TOKENS=3072
AI_MAX_OUTPUT_TOKENS=256
RAG_ENABLED=true
RAG_STORAGE_PATH=storage/rag
RAG_EMBEDDING_MODEL=embeddinggemma
RAG_TIMEOUT_SECONDS=60
RAG_TOP_K=4
RAG_MAX_CHUNKS_PER_DOCUMENT=1
RAG_MIN_SIMILARITY=0.35

# Knowledge Agent: 02:00 hằng ngày theo múi giờ Asia/Ho_Chi_Minh.
# Chỉ URL thuộc allowed_domain và khớp include_patterns mới được xét duyệt.
KNOWLEDGE_AGENT_ENABLED=true
KNOWLEDGE_AGENT_HOUR=2
KNOWLEDGE_AGENT_MAX_DOCUMENTS=20
KNOWLEDGE_AGENT_MAX_BYTES=52428800
KNOWLEDGE_AGENT_MAX_TEXT_CHARS=1000000
KNOWLEDGE_AGENT_MIN_TEXT_CHARS=800
KNOWLEDGE_AGENT_QA_SIMILARITY=0.22
KNOWLEDGE_AGENT_SOURCES_FILE=config/knowledge_sources.json
KNOWLEDGE_AGENT_SOURCES_JSON=[]

# --- Market (THITRUONG NONG SAN) ---
THITRUONG_NONGSAN_PRICE_URL=https://thitruongnongsan.gov.vn/vn/nguonwmy.aspx
THITRUONG_NONGSAN_NEWS_URL=https://thitruongnongsan.gov.vn/vn/xc0_tin-tuc.html
ENABLE_THITRUONG_NONGSAN_PRICE=true
ENABLE_THITRUONG_NONGSAN_NEWS=true

# --- Firecrawl (web scraper với JS rendering + raw storage) ---
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=false
FIRECRAWL_RAW_STORAGE_PATH=storage/raw_crawl

# --- Tavily ---
TAVILY_API_KEY=
TAVILY_ENABLED=true
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=10
TAVILY_NEWS_CACHE_TTL_MINUTES=120

# Price/news ingestion
PRICE_SOURCE_URLS_JSON=[{"name":"agro.gov.vn","url":"https://agro.gov.vn/index.aspx"},{"name":"agro.gov.vn-gia","url":"https://agro.gov.vn/vn/nguonwmy.aspx"}]
MARKET_API_BASE_URL=
ALERT_CHECK_INTERVAL_SECONDS=3600
ALERT_CHECK_ON_STARTUP=false
ENABLE_STOOQ_PRICE_SOURCE=true
THITRUONGNONGSAN_BASE_URL=https://thitruongnongsan.gov.vn
THITRUONGNONGSAN_ENABLED=true
ENABLE_REALTIME_PRICE=true
ENABLE_MARKET_NEWS=true
PRICE_CACHE_TTL_MINUTES=60
NEWS_CACHE_TTL_MINUTES=120
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
USD_VND_FALLBACK_RATE=26000
MARKET_NEWS_RSS_URLS_JSON=["https://vnexpress.net/rss/kinh-doanh.rss","https://vnexpress.net/rss/tin-moi-nhat.rss"]
MARKET_NEWS_CACHE_TTL_SECONDS=1800

# --- Retail price sources ---
RETAIL_PRICE_SOURCES_JSON=[{"name":"BachHoaXanh","url":"https://www.bachhoaxanh.com/"},{"name":"WinMart","url":"https://winmart.vn/"},{"name":"GO","url":"https://go-vietnam.vn/"},{"name":"Coopmart","url":"https://cooponline.vn/"},{"name":"MMMegaMarket","url":"https://online.mmvietnam.com/"}]

# --- Data mode ---
ALLOW_MOCK_DATA=true
ALLOW_SAMPLE_DATA=true
USE_REALTIME_ONLY=false

# --- External request resilience ---
EXTERNAL_CONNECT_TIMEOUT_SECONDS=3
EXTERNAL_READ_TIMEOUT_SECONDS=8
EXTERNAL_TOTAL_TIMEOUT_SECONDS=12
EXTERNAL_RETRY_COUNT=1
WEATHER_TIMEOUT_SECONDS=8
WEATHER_READ_TIMEOUT_SECONDS=6

# --- Background real-data refresh scheduler ---
REAL_REFRESH_ENABLED=true
REAL_REFRESH_STARTUP_DELAY_SECONDS=10
REAL_REFRESH_STAGGER_SECONDS=45
CRAWL_STARTUP_DELAY_SECONDS=60
REAL_REFRESH_REGIONS=Ha Noi,TP.HCM,Da Nang,Can Tho,Lam Dong,Dak Lak
REAL_REFRESH_CROPS=lua,ca phe,ho tieu,rau
WEATHER_CURRENT_REFRESH_SECONDS=1200
WEATHER_HOURLY_REFRESH_SECONDS=1800
WEATHER_FORECAST_REFRESH_SECONDS=7200
OFFICIAL_PRICE_REFRESH_SECONDS=7200
MARKET_NEWS_REFRESH_SECONDS=7200
TAVILY_NEWS_CACHE_TTL_MINUTES=120
RETAIL_PRICE_REFRESH_SECONDS=14400
MARKET_ANALYSIS_REFRESH_SECONDS=2700
