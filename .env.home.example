# Sao chép tệp này thành .env.home. Không commit .env.home.
# Mật khẩu phải có chữ hoa, chữ thường, số và ký tự đặc biệt.
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
# Nếu mật khẩu có @, :, / hoặc #, cần URL-encode phần mật khẩu trong DATABASE_URL.
DATABASE_URL=mssql+pymssql://sa:CHANGE_ME_STRONG_DATABASE_PASSWORD@db:1433/NongNghiepAI
SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
CLOUDFLARE_TUNNEL_TOKEN=PASTE_TUNNEL_TOKEN_HERE

ENVIRONMENT=production
BACKEND_CORS_ORIGINS=["https://agriai.vn","https://app.agriai.vn"]
ALLOW_MOCK_DATA=false
ALLOW_SAMPLE_DATA=false
USE_REALTIME_ONLY=true

AI_PROVIDER=ollama
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL_NAME=qwen3:4b-instruct
AI_CONTEXT_TOKENS=3072
AI_MAX_OUTPUT_TOKENS=256
RAG_EMBEDDING_MODEL=embeddinggemma
RAG_STORAGE_PATH=/app/storage/rag

# Email notifications (Gmail requires a 16-character App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
